import { LineEdit, ListView, Slider } from "std-widgets.slint";

export global Theme {
    out property <color> rail: #111214;
    out property <color> side: #1a1b1e;
    out property <color> panel: #151618;
    out property <color> main: #222327;
    out property <color> input: #2c2d32;
    out property <color> hover: #2b2d31;
    out property <color> hover-strong: #35373c;
    out property <color> line: #111214;
    out property <color> text: #e6e6e8;
    out property <color> body: #d4d5d8;
    out property <color> muted: #8b8d94;
    out property <color> accent: #5865f2;
    out property <color> accent-hover: #4752c4;
    out property <color> online: #23a55a;
    out property <color> warn: #f0b232;
    out property <color> danger: #da373c;
    out property <color> danger-hover: #a12d2f;
}

export struct ServerItem {
    name: string,
    initials: string,
    unread: bool,
}

export struct MsgItem {
    author: string,
    initial: string,
    color: color,
    text: string,
    // Hora curta (HH:MM), mostrada ao passar o mouse nas mensagens agrupadas.
    time: string,
    // Data completa do cabeçalho ("Hoje às 11:42").
    stamp: string,
    // Primeira mensagem de um grupo: mostra avatar, nome e data.
    head: bool,
    // Separador de dia antes da mensagem ("" quando não muda o dia).
    day: string,
}

export struct VoiceItem {
    // Chave pública em hex (para mudar o volume).
    id: string,
    name: string,
    initial: string,
    color: color,
    speaking: bool,
    me: bool,
    muted: bool,
    deafened: bool,
    // Volume que eu escolhi para a pessoa, em % (no meu caso, o do microfone).
    volume: int,
}

// ---------------------------------------------------------------- Ícones
// Traços em 24x24 (estilo Lucide), desenhados como Path: nada de imagem embutida.

component Icon inherits Path {
    in property <color> tint: Theme.text;
    width: 20px;
    height: 20px;
    viewbox-width: 24;
    viewbox-height: 24;
    stroke: root.tint;
    stroke-width: 2px;
    stroke-line-cap: round;
    stroke-line-join: round;
    fill: transparent;
}

component MicIcon inherits Icon {
    commands: "M12 2 a3 3 0 0 0 -3 3 v7 a3 3 0 0 0 6 0 V5 a3 3 0 0 0 -3 -3 Z M19 10 v2 a7 7 0 0 1 -14 0 v-2 M12 19 v3";
}

